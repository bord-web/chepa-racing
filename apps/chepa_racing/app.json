{
  "id": "chepa_racing",
  "title": "Chepa Racing",
  "description": "Chepa Racing tuner dashboard: temperatures, boost with target, ethanol, MHD map switching, knock and misfires per cylinder, boost vs target chart, tyres",  "version": "0.5.2",
  "vendor": "custom",
  "loggingId": "OAB2",
  "iconGlyph": "CR",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": { "statusEngineSpeed2": "rs", "statusEngineTemperature": "rs" },
    "de.bmw.infotainment.vehicle.Vehicle2": { "statusCarSpeed2": "rs" },
    "de.bmw.infotainment.drivingexcitement.FES": { "statusActualValueTorque2": "rs" },
    "de.bmw.powertrain.AcceleratorPedal": { "_optional": "the accelerator pedal: pulls are then told by engine load", "AngleAcceleratorPedal": "s" },
    "de.bmw.infotainment.vehicle.TPMS": { "_optional": "tyre pressures and temperatures (the tyres panel on Vitals)",
      "statusTyreTemperature": "rs", "statusTyrePressure": "rs", "statusTargetTyrePressure": "rs" },
    "de.bmw.infotainment.vehicle.Vehicle": { "_optional": "the car's display units; tyre pressures / temperatures are then told by their values",
      "statusNewCurrentUnitsStatusExt": "rs" },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    }
  },
  "screens": [
    { "name": "MAIN", "kind": "canvas", "title": "Chepa Racing",
      "buttons": [["BTN_PAGE", "Next page"], ["BTN_SETTINGS", "Settings"]] }
  ],
  "settings": [
    { "key": "page", "label": "Start page", "type": "choice", "default": "vitals", "options": [["vitals", "Vitals"], ["boost", "Boost chart"], ["log", "Pull log"]] },
    { "key": "centre", "label": "Vitals: centre panel", "type": "choice", "default": "boost",
      "options": [["boost", "Boost dial"], ["tyres", "Tyres: pressure and temperature"], ["logo", "Chepa Racing logo"]] },

    { "key": "pullLog", "label": "Pull log: record pulls", "type": "bool", "default": true },
    { "key": "retardView", "label": "Cylinder tiles show", "type": "choice", "default": "pull",
      "options": [["pull", "Last pull (held until the next)"], ["live", "Live retard"]] },
    { "key": "pullStart", "label": "A pull starts at accelerator", "type": "number", "unit": "%", "default": 80,
      "steps": [50, 60, 70, 80, 90, 95] },
    { "key": "pullMin", "label": "Shortest pull kept in the log", "type": "number", "unit": "s", "default": 2,
      "steps": [1, 2, 3, 4, 5, 8] },

    { "key": "mapControl", "label": "Map switching", "type": "choice", "default": "sim",
      "options": [["sim", "Simulated (nothing is sent)"], ["mhd", "MHD: send to the DME"]] },
    { "key": "map1Name", "label": "Map 1 name", "type": "choice", "default": "stock",
      "options": [["none", "-"], ["stock", "Stock"], ["valet", "Valet"], ["street", "Street"], ["s1", "Stage 1"], ["s2", "Stage 2"], ["s2p", "Stage 2+"], ["e30", "E30"], ["e40", "E40"], ["e50", "E50"], ["e85", "E85"], ["race", "Race"], ["track", "Track"]] },
    { "key": "map2Name", "label": "Map 2 name", "type": "choice", "default": "s1",
      "options": [["none", "-"], ["stock", "Stock"], ["valet", "Valet"], ["street", "Street"], ["s1", "Stage 1"], ["s2", "Stage 2"], ["s2p", "Stage 2+"], ["e30", "E30"], ["e40", "E40"], ["e50", "E50"], ["e85", "E85"], ["race", "Race"], ["track", "Track"]] },
    { "key": "map3Name", "label": "Map 3 name", "type": "choice", "default": "e30",
      "options": [["none", "-"], ["stock", "Stock"], ["valet", "Valet"], ["street", "Street"], ["s1", "Stage 1"], ["s2", "Stage 2"], ["s2p", "Stage 2+"], ["e30", "E30"], ["e40", "E40"], ["e50", "E50"], ["e85", "E85"], ["race", "Race"], ["track", "Track"]] },
    { "key": "map4Name", "label": "Map 4 name", "type": "choice", "default": "valet",
      "options": [["none", "-"], ["stock", "Stock"], ["valet", "Valet"], ["street", "Street"], ["s1", "Stage 1"], ["s2", "Stage 2"], ["s2p", "Stage 2+"], ["e30", "E30"], ["e40", "E40"], ["e50", "E50"], ["e85", "E85"], ["race", "Race"], ["track", "Track"]] },

    { "key": "minBoost", "label": "Boost scale start", "type": "number", "unit": "bar", "default": -0.2,
      "steps": [-1.0, -0.5, -0.3, -0.2, -0.1, 0] },
    { "key": "maxBoost", "label": "Engine max boost (end of the boost scale)", "type": "number", "unit": "bar", "default": 2.0, "reset": 1,
      "steps": [1.5, 1.75, 2.0, 2.25, 2.5, 2.75, 3.0, 3.25, 3.5, 4.0] },
    { "key": "maxTorque", "label": "Engine max torque", "type": "number", "unit": "Nm", "default": 650,
      "steps": [500, 550, 600, 650, 700, 750, 800, 850, 900, 950, 1000, 1050, 1100, 1150, 1200, 1250, 1300, 1350, 1400] },
    { "key": "maxPower", "label": "Engine max power", "type": "number", "unit": "hp", "default": 503,
      "steps": [400, 450, 473, 480, 503, 520, 550, 580, 600, 620, 650, 680, 700, 750, 800, 850, 900, 950, 1000,
                1050, 1100, 1150, 1200, 1250, 1300, 1350, 1400, 1450, 1500] },

    { "key": "oilCold", "label": "Engine oil: blue below", "type": "number", "unit": "°C", "default": 50,
      "steps": [20, 30, 40, 50, 60, 70, 80] },
    { "key": "oilWarn", "label": "Engine oil: yellow from", "type": "number", "unit": "°C", "default": 100,
      "steps": [80, 85, 90, 95, 100, 105, 110, 115, 120, 125, 130] },
    { "key": "oilCrit", "label": "Engine oil: red from", "type": "number", "unit": "°C", "default": 110,
      "steps": [90, 95, 100, 105, 110, 115, 120, 125, 130, 135, 140, 150] },

    { "key": "waterCold", "label": "Water: blue below", "type": "number", "unit": "°C", "default": 50,
      "steps": [20, 30, 40, 50, 60, 70, 80] },
    { "key": "waterWarn", "label": "Water: yellow from", "type": "number", "unit": "°C", "default": 105,
      "steps": [85, 90, 95, 100, 105, 110, 115, 120] },
    { "key": "waterCrit", "label": "Water: red from", "type": "number", "unit": "°C", "default": 112,
      "steps": [95, 100, 105, 108, 110, 112, 115, 118, 120, 125] },

    { "key": "gearCold", "label": "Gearbox oil: blue below", "type": "number", "unit": "°C", "default": 40,
      "steps": [20, 30, 40, 50, 60, 70] },
    { "key": "gearWarn", "label": "Gearbox oil: yellow from", "type": "number", "unit": "°C", "default": 100,
      "steps": [80, 85, 90, 95, 100, 105, 110, 115, 120] },
    { "key": "gearCrit", "label": "Gearbox oil: red from", "type": "number", "unit": "°C", "default": 115,
      "steps": [90, 95, 100, 105, 110, 115, 120, 125, 130, 140] },

    { "key": "iatCold", "label": "Intake air: blue below", "type": "number", "unit": "°C", "default": 5,
      "steps": [-20, -10, 0, 5, 10, 15, 20] },
    { "key": "iatWarn", "label": "Intake air: yellow from", "type": "number", "unit": "°C", "default": 45,
      "steps": [30, 35, 40, 45, 50, 55, 60, 65, 70] },
    { "key": "iatCrit", "label": "Intake air: red from", "type": "number", "unit": "°C", "default": 60,
      "steps": [40, 45, 50, 55, 60, 65, 70, 75, 80, 90] },

    { "key": "tyreCold", "label": "Tyres: blue below", "type": "number", "unit": "°C", "default": 20,
      "steps": [0, 10, 15, 20, 25, 30, 40, 50] },
    { "key": "tyreWarn", "label": "Tyres: yellow from", "type": "number", "unit": "°C", "default": 90,
      "steps": [60, 70, 80, 85, 90, 95, 100, 105] },
    { "key": "tyreCrit", "label": "Tyres: red from", "type": "number", "unit": "°C", "default": 105,
      "steps": [80, 90, 95, 100, 105, 110, 115, 120] },

    { "key": "pressUnit", "label": "Pressure unit (boost, tyres)", "type": "choice", "default": "bar", "options": [["bar", "bar"], ["psi", "psi"]] },
    { "key": "tempUnit", "label": "Temperature", "type": "choice", "default": "c", "options": [["c", "Celsius"], ["f", "Fahrenheit"]] },
    { "key": "window", "label": "Boost chart length", "type": "number", "unit": "s", "default": 30, "steps": [15, 30, 60, 120, 180] },
    { "key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour",
      "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]] },
    { "key": "layout", "label": "Screen layout", "type": "choice", "default": "full", "options": [["full", "Full screen"], ["standard", "Standard"]] },
    { "key": "renderer", "label": "Renderer", "type": "choice", "default": "auto", "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]] },
    { "key": "demo", "label": "Demo data", "type": "choice", "default": "auto", "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]] },
    { "key": "devTab", "label": "Dev logs tab (flex fuel: what the DME answers)", "type": "bool", "default": false }
  ]
}
